# Socket-activated: nothing privileged runs until a controller connects, and
# every connection gets its own routedroid-helper@<n>.service instance,
# so several phones can be up at once and one session's crash leaves the
# others alone.
[Unit]
Description=Routedroid helper (control socket)

[Socket]
ListenSequentialPacket=/run/routedroid/helper.sock
# Anyone may connect; the helper itself admits only root and group
# routedroid (serve --allow-group), before reading a request.
SocketMode=0666
SocketUser=root
SocketGroup=root
DirectoryMode=0755
RemoveOnStop=yes
Accept=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
