# Privileged helper (architecture §5.3): one instance per controller
# connection (the socket unit is Accept=yes), no restart, independent
# root-owned cleanup after any exit, and a start guard that refuses to run
# while an orphaned journal exists. Instances share the LAN interface's
# sysctls through reference-counted claims in /var/lib/routedroid/sysctl.
[Unit]
Description=Routedroid privileged helper (session %i)
Requires=routedroid-helper.socket
CollectMode=inactive-or-failed
After=network.target
# Every controller connect is a fresh start by design; the default 5-in-10s
# rate limit would refuse quick reconnects (and the kill matrix) as a crash loop.
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=no
# The accepted connection arrives as LISTEN_FDS (Accept=yes).
NonBlocking=yes
ExecStartPre=/usr/local/libexec/routedroid/routedroid-helper check
ExecStart=/usr/local/libexec/routedroid/routedroid-helper serve
# Runs after ExecStart exits for ANY reason, including SIGKILL. Failure -> unit failed.
ExecStopPost=/usr/local/libexec/routedroid/routedroid-helper cleanup
# journal in /var/lib/routedroid, socket/crash hook in /run/routedroid
StateDirectory=routedroid
RuntimeDirectory=routedroid
RuntimeDirectoryPreserve=yes
# Least privilege: root uid (for /proc/sys, nft, ip) but only network capabilities.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
DeviceAllow=/dev/net/tun rw
ReadWritePaths=/proc/sys/net/ipv4
KillMode=process
TimeoutStopSec=10
Environment=RUST_LOG=info
