# Socket-activated: nothing privileged runs until a controller connects, and
# every connection gets its own routedroid-phase0-helper@<n>.service instance,
# so several phones can be up at once and one session's crash leaves the
# others alone.
[Unit]
Description=Routedroid helper (control socket)

[Socket]
ListenSequentialPacket=/run/routedroid/phase0-helper.sock
SocketMode=0660
SocketUser=root
SocketGroup=routedroid
DirectoryMode=0755
RemoveOnStop=yes
Accept=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
