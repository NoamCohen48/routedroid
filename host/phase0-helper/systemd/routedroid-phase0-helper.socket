# Phase 0 helper gate spike. Socket-activated: nothing privileged runs until a
# controller connects; the service exits after one session and the socket
# unit stays armed for the next one.
[Unit]
Description=Routedroid Phase 0 helper (control socket)

[Socket]
ListenSequentialPacket=/run/routedroid/phase0-helper.sock
SocketMode=0660
SocketUser=root
SocketGroup=routedroid
DirectoryMode=0755
RemoveOnStop=yes
# One connection is served per service instance; further connectors queue.
Backlog=4

[Install]
WantedBy=sockets.target
