    <string name="diag_sent">Sent: packets %1$d, bytes %2$d</string>
    <string name="diag_received">Received: packets %1$d, bytes %2$d</string>
    <string name="diag_not_sent">Not sent: non-IPv4 %1$d, over the MTU %2$d</string>
    <string name="diag_not_delivered">Not delivered: invalid %1$d</string>
