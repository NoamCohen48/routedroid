<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Routedroid"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            protocol/version-1.md §7.2: started by the host via
            `am start -n dev.routedroid/.BootstrapActivity` with extras `session` and `device_port`.
            Exported so the shell can start it; no intent-filter, so it is neither browsable nor
            reachable by implicit intents. Does nothing observable without a matching record.
        -->
        <activity
            android:name=".BootstrapActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Routedroid.Bootstrap" />

        <!--
            §7.1 bootstrap record sink for `adb shell content write`
            (content://dev.routedroid.bootstrap/record). Exported for the shell but gated by DUMP,
            which only shell/system hold; the provider also checks the caller UID is the shell UID.
        -->
        <provider
            android:name=".bootstrap.BootstrapProvider"
            android:authorities="dev.routedroid.bootstrap"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".vpn.RoutedroidVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Raw IP tunnel between this device and the USB-attached PC over adb" />
        </service>
    </application>
</manifest>
