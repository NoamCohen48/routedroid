<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RoutedroidApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Routedroid"
        tools:targetApi="33">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            protocol/version-1.md §7.2: started by the host with
            `am start -n dev.routedroid/.bootstrap.BootstrapActivity -\-es session <id>`.
            Exported so the shell can start it, with no intent filter. Its own task (empty
            affinity), so the main screen it opens never lands in a task hidden from recents.
        -->
        <activity
            android:name=".bootstrap.BootstrapActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Routedroid.Bootstrap" />

        <!--
            §7.1 record sink for `adb shell content write`. Gated by DUMP, which only the shell
            and the system hold; openFile() also requires the shell UID.
        -->
        <provider
            android:name=".bootstrap.BootstrapProvider"
            android:authorities="dev.routedroid.bootstrap"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.DUMP" />

        <!--
            specialUse rather than systemExempted: the foreground service starts before the
            VPN is established, when the app does not yet qualify as an active VPN.
        -->
        <service
            android:name=".vpn.RoutedroidVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- A session needs the PC to start it; always-on would only blackhole traffic. -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Raw IP tunnel between this device and the USB-attached PC over adb" />
        </service>
    </application>
</manifest>
